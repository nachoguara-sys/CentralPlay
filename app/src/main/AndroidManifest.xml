<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature android:name="android.software.picture_in_picture" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".CentralPlayApp"
        android:allowBackup="true"
        android:icon="@drawable/centralplay_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/centralplay_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.CentralPlay.Starting"
        android:usesCleartextTraffic="true">

        <activity android:name=".ui.HistoryActivity" android:exported="false" />
        <activity
            android:name=".ui.DiagnosticsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.SeriesDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.PlayerActivity"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout"
            android:exported="false"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.CentralPlay.Player" />
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CentralPlay.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
