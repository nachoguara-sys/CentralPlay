<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#173B5B" android:endColor="#0A1728" android:angle="270" />
            <stroke android:width="3dp" android:color="@color/cp_focus" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cp_surface" />
            <stroke android:width="1dp" android:color="#243B55" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
